{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 3000
    },
    {
      "name": "django",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "set -a; . ./.env; set +a; .venv/bin/python manage.py runserver 8010"],
      "port": 8010
    },
    {
      "name": "docs",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd docs/build/html && python3 -m http.server 8020"],
      "port": 8020
    }
  ]
}
